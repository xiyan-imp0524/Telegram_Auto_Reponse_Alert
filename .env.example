# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Chat ID to receive notifications (user or group)
TELEGRAM_CHAT_ID=your_chat_id_here

# Monitor mode: pusher (instant) or poll (every few seconds)
MONITOR_MODE=pusher

# Workana session cookie (required for pusher/hybrid mode)
WORKANA_COOKIE=workana_session=your_session_here

# Health watchdog (Telegram alert + auto-restart on sustained Workana outage)
HEALTH_FAIL_THRESHOLD=5
HEALTH_EMPTY_THRESHOLD=8
HEALTH_ALERT_COOLDOWN_SECONDS=300
HEARTBEAT_PATH=data/heartbeat.txt

# Polling settings (only used when MONITOR_MODE=poll)
POLL_INTERVAL_SECONDS=5
MIN_POLL_INTERVAL_SECONDS=3

# On first start, mark current listings as seen (no flood of old jobs)
BOOTSTRAP_ON_START=true

# Workana settings
WORKANA_LANGUAGE=en
# Monitor all Workana languages (English, Spanish, Portuguese)
WORKANA_LANGUAGES=en,es,pt
WORKANA_CATEGORY=it-programming

# Notify ALL jobs in the category (recommended). Set false to enable filters below.
NOTIFY_ALL=true

# Optional filters (only used when NOTIFY_ALL=false)
PREFERRED_SKILLS=
KEYWORDS=
EXCLUDED_KEYWORDS=
MIN_BUDGET_USD=0
MAX_BIDS=
MAX_AGE_HOURS=
